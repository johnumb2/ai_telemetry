server {
  listen __APP_PORT__;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # -----------------------------------------------------------
  # AUTH: auth_check subrequest (nginx -> auths /authz) and the app's
  # /api/* API proxy (all auths endpoints live under /api/).
  # The SPA + static assets stay public so the login page loads un-authed;
  # only the data endpoints (/metrics, /host-metrics) require a session.
  # -----------------------------------------------------------
  location = /__auth {
    internal;
    proxy_pass __AUTH_PROXY__/authz;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    proxy_pass __AUTH_PROXY__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
  }

  # -----------------------------------------------------------
  # Reverse proxy -> the LLM / metrics endpoint
  # The app fetches the same-origin relative path (e.g. /metrics),
  # so it works in the browser with zero CORS configuration.
  # auth_request gates the whole location behind a valid session.
  # -----------------------------------------------------------
  location __METRICS_LOCATION__ {
    auth_request /__auth;
    proxy_pass __METRICS_PROXY__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    # handy for direct (non-browser) fetches from other origins
    add_header Access-Control-Allow-Origin "*" always;
  }

  # -----------------------------------------------------------
  # Reverse proxy -> the hoststats sidecar (host telemetry)
  # -----------------------------------------------------------
  location /host-metrics {
    auth_request /__auth;
    proxy_pass __HOST_METRICS_PROXY__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    add_header Access-Control-Allow-Origin "*" always;
  }

  # Static build assets (long-lived cache, hashed by Vite)
  location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Single-page app fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
